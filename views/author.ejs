<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
    />
    <link rel="stylesheet" href="/main.css" />
    <title>Portfolio</title>
  </head>

  <body>
    <div class="frame">
      <div class="main_frame">
        <div class="left_frame">
          <div class="left_1">
            <div class="left_1-1">
              <img
                src="/author/images/Profile.png"
                width="156px"
                height="142px"
                alt="Profile rasm"
              />
            </div>
            <div class="left_1-2"><%=user.name%></div>
            <div class="left_1-3"><%=user.profession%></div>
            <div class="left-icons">
              <a class="link_href" href="">
                <div class="icon">
                  <img src="/author/icon/Dribbble.svg" alt="" class="icon-1" />
                </div>
              </a>
              <a class="link_href" href="">
                <div class="icon">
                  <img src="/author/icon/Facebook.svg" alt="" class="icon-1" />
                </div>
              </a>
              <a class="link_href" href="">
                <div class="icon">
                  <img src="/author/icon/Instagram.svg" alt="" class="icon-1" />
                </div>
              </a>
              <a class="link_href" href="">
                <div class="icon">
                  <img src="/author/icon/Linkeding.svg" alt="" class="icon-1" />
                </div>
              </a>
              <a class="link_href" href="">
                <div class="icon">
                  <img src="/author/icon/Twitter.svg" alt="" class="icon-1" />
                </div>
              </a>
              <a class="link_href" href="">
                <div class="icon">
                  <img src="/author/icon/Youtube.svg" alt="" class="icon-1" />
                </div>
              </a>
            </div>
          </div>
          <div class="marginer"></div>

          <div class="left_2">
            <div class="info-box">
              <div class="info-row">
                <span class="label">Age:</span>
                <span>24</span>
              </div>

              <div class="info-row">
                <span class="label">Residence:</span>
                <span>BD</span>
              </div>

              <div class="info-row">
                <span class="label">Freelance:</span>
                <span style="color: #7eb942">Available</span>
              </div>

              <div class="info-row">
                <span class="label">Address:</span>
                <span>Dhaka, Bangladesh</span>
              </div>
            </div>
          </div>

          <div class="marginer"></div>

          <div class="left_3">
            <div class="skills-box">
              <h2>Languages</h2>

              <div class="skill">
                <div class="skill-info">
                  <span>Bangla</span>
                  <span>100%</span>
                </div>
                <div class="progress">
                  <div class="progress-bar"></div>
                </div>
              </div>

              <div class="skill">
                <div class="skill-info">
                  <span>English</span>
                  <span>80%</span>
                </div>
                <div class="progress">
                  <div class="progress-bar js"></div>
                </div>
              </div>

              <div class="skill">
                <div class="skill-info">
                  <span>Spanish</span>
                  <span>60%</span>
                </div>
                <div class="progress">
                  <div class="progress-bar spanish"></div>
                </div>
              </div>
            </div>
          </div>

          <div class="marginer"></div>

          <div class="left_4">
            <div class="skills-box">
              <h2>Skills</h2>

              <div class="skill">
                <div class="skill-info">
                  <span>Html</span>
                  <span>90%</span>
                </div>
                <div class="progress">
                  <div class="progress-bar html"></div>
                </div>
              </div>

              <div class="skill">
                <div class="skill-info">
                  <span>CSS</span>
                  <span>85%</span>
                </div>
                <div class="progress">
                  <div class="progress-bar css"></div>
                </div>
              </div>

              <div class="skill">
                <div class="skill-info">
                  <span>Js</span>
                  <span>80%</span>
                </div>
                <div class="progress">
                  <div class="progress-bar js"></div>
                </div>
              </div>

              <div class="skill">
                <div class="skill-info">
                  <span>PHP</span>
                  <span>75%</span>
                </div>
                <div class="progress">
                  <div class="progress-bar php"></div>
                </div>
              </div>

              <div class="skill">
                <div class="skill-info">
                  <span>WordPress</span>
                  <span>85%</span>
                </div>
                <div class="progress">
                  <div class="progress-bar wordpress"></div>
                </div>
              </div>
            </div>
          </div>

          <div class="marginer"></div>

          <div class="left_5">
            <div class="extra-skills-box">
              <h2>Extra Skills</h2>

              <ul>
                <li>Bootstrap, Materialize</li>
                <li>Stylus, Sass, Less</li>
                <li>Gulp, Webpack, Grunt</li>
                <li>GIT Knowledge</li>
              </ul>
            </div>
          </div>

          <div class="marginer"></div>
        </div>
        <div class="midd_frame">
          <section class="hero_section">
            <div class="hero_text">
              <h1>Doctor neurologists<br />in OHSU Hospital</h1>

              <p>
                Lorem Ipsum Dolor Sit Amet, Consectetur Adipiscing Elit. Et,
                Volutpat Feugiat Placerat Lobortis. Natoque Rutrum Semper Sed
                Suspendisse Nunc Lectus.
              </p>

              <button class="hire_btn">HIRE ME →</button>
            </div>

            <div class="hero_image">
              <img src="/author/images/Your Image 1.png" alt="Doctor" />
            </div>
          </section>
          <section class="services_intro">
            <h2>My Services</h2>

            <p>
              Amet Minim Mollit Non Deserunt Ullamco Est Sit Aliqua Dolor Do
              Amet Sint. Velit Officia Consequat Duis Enim Velit Mollit. Lorem
              Ipsum. Velit Officia Consequat Duis Enim Velit Mollit. Lorem
              Ipsum.
            </p>
          </section>
          <section class="services_grid">
            <!-- BOX 1 -->
            <div class="service_box">
              <div class="service_icon">🖥️</div>

              <h3>Web Development</h3>

              <p>Blog, E-Commerce</p>
            </div>

            <!-- BOX 2 -->
            <div class="service_box">
              <div class="service_icon">🖌️</div>

              <h3>UI/UX Design</h3>

              <p>Mobile App, Website Design</p>
            </div>

            <!-- BOX 3 -->
            <div class="service_box">
              <div class="service_icon">🎙️</div>

              <h3>Sound Design</h3>

              <p>Voice Over, Beat Making</p>
            </div>

            <!-- BOX 4 -->
            <div class="service_box">
              <div class="service_icon">🎮</div>

              <h3>Game Design</h3>

              <p>Character Design, Props & Objects</p>
            </div>

            <!-- BOX 5 -->
            <div class="service_box">
              <div class="service_icon">📷</div>

              <h3>Photography</h3>

              <p>Portrait, Product Photography</p>
            </div>

            <!-- BOX 6 -->
            <div class="service_box">
              <h3>Advertising</h3>

              <p>
                Lorem Ipsum Dolor Sit Amet, Consectetur Adipiscing Elit. Vitae
                Nulla Diam In Ac Dictum A Urna Viverra Morbi.
              </p>

              <a href="#">READ MORE →</a>
            </div>
          </section>
        </div>
        <div class="right_frame">
          <div class="nav_icon dark_mode">
            <img src="/author/menu_icon/Contrast.svg" alt="">
          </div>

          <!-- Home -->
          <div class="nav_icon">
            <img src="/author/menu_icon/Portfolio.svg" alt="">
          </div>

          <!-- Services -->
          <div class="nav_icon">
            <img src="/author/menu_icon/Service.svg" alt="">
          </div>

          <!-- Education -->
          <div class="nav_icon">
            <img src="/author/menu_icon/Cv.svg" alt="">
          </div>

          <!-- Work -->
          <div class="nav_icon">
            <img src="/author/menu_icon/Portfolio.svg" alt="">
          </div>

          <!-- Contact -->
          <div class="nav_icon">
            <img src="/author/menu_icon/Blog.svg" alt="">
          </div>

          <!-- Message -->
          <div class="nav_icon">
            <img src="/author/menu_icon/Contact.svg" alt="">
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
